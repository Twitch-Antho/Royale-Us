<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>
        <AssemblyName>RoyaleUs.Couleurs</AssemblyName>
        <RootNamespace>RoyaleUs.Couleurs</RootNamespace>
        <Version>1.0.0</Version>
        <Description>Couleurs supplémentaires pour Royale Us (basé sur le mod Rainbow de MoltenMods)</Description>
        <Authors>Antho</Authors>
        <AmongUs Condition="'$(AmongUs)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUs>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="Reactor" Version="2.5.1-ci.400" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('$(AmongUs)\BepInEx\plugins')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUs)\BepInEx\plugins\" />
    </Target>
</Project>
